<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MapaHome">


    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_layout" />


    <!--

   -!!-->

    <androidx.cardview.widget.CardView
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="70dp"
        android:background="@color/white"
        android:visibility="visible"
        app:cardCornerRadius="20dp">
        <fragment
            android:id="@+id/placeAutocompleteOrigin"
            android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.cardview.widget.CardView>

    <!--Boton ir a ventana de reportes
    -!!-->


    <!--
    Boton flotante
    -!!-->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnIrReportes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginBottom="100dp"
        android:layout_marginLeft="25dp"
        android:contentDescription="Buscar"
        android:src="@drawable/fileopen" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnOrigenDestino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="25dp"
        android:contentDescription="Buscar"
        android:src="@drawable/arrowjump" />

    <!--
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/btnCerrarSecion"
            android:layout_width="wrap_content"
            android:layout_height="66dp"

            android:text="CERRA SESIÓN" />
    </LinearLayout>
    -->
</androidx.coordinatorlayout.widget.CoordinatorLayout>