<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.Reportes">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/reportes2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="208dp"
            android:layout_height="173dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/advertencia"
            android:contentDescription="@string/todo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgButtonBache"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bache"
                android:contentDescription="@string/todo2" />

            <ImageView
                android:id="@+id/imgButtonLuz"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/luz"
                android:contentDescription="@string/todo2" />

            <ImageView
                android:id="@+id/imgButtonRobo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/robo"
                android:contentDescription="@string/todo2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#562196F3">
            <CheckBox
                android:id="@+id/radioBtnBache"
                android:layout_width="131dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/bache" />

            <CheckBox
                android:id="@+id/radioBtnLuz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/baja_iluminaci_n" />

            <CheckBox
                android:id="@+id/radioBtnRobo"
                android:layout_width="123dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/robo" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="147dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnCamara"
                android:layout_width="167dp"
                android:layout_height="49dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:contentDescription="@string/camara"
                android:scaleType="fitCenter"
                android:src="@drawable/camara" />

        </LinearLayout>

        <EditText
            android:id="@+id/editTextComentario"
            android:layout_width="match_parent"
            android:layout_height="213dp"
            android:layout_weight="1"
            android:gravity="start"
            android:hint="@string/ingrese_un_comentario"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:scrollbars="vertical"
            android:background="#562196F3"/>

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_vertical"
            android:text="@string/reportar"
            android:onClick="writeFireBase"
            android:backgroundTint="#744CAF50"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>